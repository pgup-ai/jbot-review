# install.sh substitutes the real hostname and writes this to /etc/caddy/Caddyfile.
# Caddy auto-provisions and renews the Let's Encrypt certificate.
{$OBSERVER_HOSTNAME} {
	# Compress the bulk responses, never the live stream: encoding buffers, and
	# text/event-stream must reach the browser as it arrives. ~34x on a journal.
	encode {
		zstd
		gzip
		match {
			header Content-Type application/x-ndjson*
			header Content-Type application/json*
			header Content-Type text/html*
		}
	}
	# SSE + streaming ingest: forward bytes as they arrive, never buffer.
	reverse_proxy 127.0.0.1:8790 {
		flush_interval -1
	}
}
