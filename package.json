{
  "name": "jbot-review",
  "version": "0.1.0",
  "description": "Agentic PR reviewer: opencode serve + SDK, with a gated inline-posting step.",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsx scripts/build.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "dev": "tsx src/app/server.ts",
    "review:local": "tsx src/local/index.ts",
    "benchmark:review": "tsx scripts/review-benchmark.ts",
    "performance:review": "tsx scripts/review-performance.ts",
    "gateway": "tsx src/gateway/server.ts",
    "gateway:demo": "tsx src/gateway/demo.ts",
    "models:update": "tsx scripts/update-model-catalog.ts",
    "env:minify-auth": "tsx scripts/minify-env-auth.ts",
    "findings:dispositions": "tsx scripts/finding-dispositions.ts",
    "guidelines:candidates": "tsx scripts/guideline-candidates.ts",
    "companion": "tsx src/companion/index.ts",
    "dim:bundle": "tsx scripts/dim-bundle.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@octokit/auth-app": "^8.3.0",
    "@octokit/plugin-paginate-rest": "^15.0.0",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@octokit/webhooks": "^14.2.0",
    "@opencode-ai/sdk": "^1.18.14",
    "@qoder-ai/qoder-agent-sdk": "^1.0.19",
    "@symma/client": "0.5.0",
    "@symma/protocol": "0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  }
}
